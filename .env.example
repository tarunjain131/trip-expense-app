# PostgreSQL connection string (Neon / Supabase / Railway / local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign login session cookies. REQUIRED in production (without it the app stays locked).
# Generate with: openssl rand -hex 32   (changing it logs everyone out)
AUTH_SECRET=""
# Email of the account that adopts trips created before accounts existed (they have no owner).
LEGACY_OWNER_EMAIL=""
